<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wedding Invitation</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-serif { font-family: 'Cormorant Garamond', serif; }
  </style>
</head>
<body class="bg-stone-100 text-stone-800 min-h-screen flex items-center justify-center p-4">

  <div class="w-full max-w-md bg-white border border-stone-200 rounded-2xl shadow-xl overflow-hidden p-6 sm:p-8 text-center">
    
    <p class="text-xs tracking-widest text-stone-400 uppercase mb-3">Walimatul Urus</p>
    <h1 class="font-serif text-4xl text-stone-900 tracking-wide italic">Lidyana & Azizul</h1>
    <div class="w-12 h-0.5 bg-amber-600/40 mx-auto my-4"></div>
    <p class="text-xs uppercase tracking-widest text-stone-500 mb-6">Dengan penuh kesyukuran ke hadrat Ilahi, kami menjemput untuk meraikan penyatuan janji & ikatan kasih </p>

    <!-- Guest Card -->
    <div class="bg-stone-50 border border-stone-200 rounded-xl p-4 mb-6">
      <p class="text-xs text-stone-400 uppercase tracking-wider mb-1">Jemputan Khas Buat:</p>
      <h2 class="font-serif text-2xl font-bold text-stone-800"><%= guest.name %></h2>
      <p class="text-xs text-amber-800/80 bg-amber-50 inline-block px-2.5 py-1 rounded-full border border-amber-200/60 mt-2 font-medium">
        Dikhaskan untuk <%= guest.max_pax %> orang / pax
      </p>
    </div>

    <!-- Date & Venue -->
    <div class="space-y-2 text-sm text-stone-600 border-t border-b border-stone-100 py-4 mb-6">
      <p class="font-semibold text-stone-800">Sabtu, 18 Disember 2025, 11:00 Pagi – 4:00 Petang, di </p>
      <p class="text-xs text-stone-500">Keningau</p>
    </div>

    <% if (success) { %>
      <!-- Flash message after submission -->
      <div class="bg-green-50 border border-green-200 text-green-800 rounded-xl p-4 mb-6">
        <p class="font-bold text-sm">Terima kasih, <%= guest.name %>!</p>
        <p class="text-xs mt-1">Pengesahan kehadiran anda telah direkodkan. Kehadiran anda amat bermakna buat kami.</p>
      </div>
    <% } %>

    <!-- RSVP FORM -->
    <form action="/rsvp" method="POST" class="space-y-4 text-left">
      <input type="hidden" name="slug" value="<%= guest.slug %>">

      <label class="block text-xs font-semibold text-stone-700 uppercase tracking-wider">Adakah anda akan hadir?</label>
      <div class="grid grid-cols-2 gap-3">
        <label class="border border-stone-300 rounded-lg p-3 text-center cursor-pointer has-[:checked]:border-stone-900 has-[:checked]:bg-stone-900 has-[:checked]:text-white">
          <input type="radio" name="attendance" value="yes" class="sr-only" <%= guest.status === 'attending' || guest.status === 'pending' ? 'checked' : '' %> onchange="togglePax(true)">
          <span class="text-sm font-medium">Ya, hadir</span>
        </label>
        <label class="border border-stone-300 rounded-lg p-3 text-center cursor-pointer has-[:checked]:border-stone-900 has-[:checked]:bg-stone-900 has-[:checked]:text-white">
          <input type="radio" name="attendance" value="no" class="sr-only" <%= guest.status === 'declined' ? 'checked' : '' %> onchange="togglePax(false)">
          <span class="text-sm font-medium">Maaf, tidak hadir</span>
        </label>
      </div>

      <div id="pax-wrapper" class="<%= guest.status === 'declined' ? 'hidden' : '' %>">
        <label class="block text-xs font-semibold text-stone-700 uppercase tracking-wider mb-1 mt-2">Bilangan Kehadiran</label>
        <select name="pax" class="w-full border border-stone-300 rounded-lg p-2.5 text-sm bg-white">
          <% for(let i = 1; i <= guest.max_pax; i++) { %>
            <option value="<%= i %>" <%= (guest.attending_pax || guest.max_pax) === i ? 'selected' : '' %>><%= i %> Orang</option>
          <% } %>
        </select>
      </div>

      <button type="submit" class="w-full bg-stone-900 hover:bg-stone-800 text-white font-medium py-3 rounded-lg text-sm transition mt-4">
        Hantar Pengesahan
      </button>
    </form>

  </div>

  <script>
    function togglePax(show) {
      document.getElementById('pax-wrapper').classList.toggle('hidden', !show);
    }
  </script>
</body>
</html>